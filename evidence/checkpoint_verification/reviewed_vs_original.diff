+subroutine timo_cowper_angular_acceleration(l,e,gs,rho,area,iner,gf,ka,phi,kappa,ok)
+  ! Lalanne & Ferraris, pp.2-4, Eqs.(1.2)-(1.7):
+  ! T_cross = Omega * qdot^T B q, B = integral 2*rho*I*N_psi^T*N_theta dy.
+  ! With phi_spin prescribed and zero generalized drive work in the two tilt
+  ! coordinates, K_alpha=B and G=B-transpose(B).  A physical driving torque
+  ! may contribute additional tilt work; the production ramp gate handles that
+  ! currently unspecified contract.  Never infer B by copying the assembled G.
+  ! The complete Timoshenko rotation fields below match the native M/K/G
+  ! interpolation. Three-point Gauss integration is exact (quartic integrand).
+  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+  implicit none
+  real(lrk), intent(in) :: l,e,gs,rho,area,iner,gf
+  real(lrk), intent(out) :: ka(8,8),phi,kappa
+  integer, intent(out) :: ok
+  real(lrk) :: absc(3),weights(3),xi,r(4),nx(8),nz(8),scale
+  integer :: k,i,j
+
+  ka=0.0_lrk; phi=0.0_lrk; kappa=0.0_lrk; ok=-1
+  ! Test finiteness before ordered comparisons or any arithmetic; quiet NaN
+  ! must be rejected without an invalid-operation trap in the Debug profile.
+  if (.not.all(ieee_is_finite([l,e,gs,rho,area,iner,gf]))) return
+  if (l<=0.0_lrk .or. rho<=0.0_lrk) return
+  call cowper_properties(e,gs,area,iner,kappa,phi,ok)
+  if (ok<0) return
+  phi=12.0_lrk*e*iner/(kappa*gs*area*l*l)
+  absc=[-sqrt(3.0_lrk/5.0_lrk),0.0_lrk,sqrt(3.0_lrk/5.0_lrk)]
+  weights=[5.0_lrk/9.0_lrk,8.0_lrk/9.0_lrk,5.0_lrk/9.0_lrk]
+  do k=1,3
+    xi=(absc(k)+1.0_lrk)/2.0_lrk
+    r(1)=6.0_lrk*xi*(xi-1.0_lrk)/(l*(1.0_lrk+phi))
+    r(2)=(1.0_lrk-4.0_lrk*xi+3.0_lrk*xi*xi+(1.0_lrk-xi)*phi)/(1.0_lrk+phi)
+    r(3)=-r(1)
+    r(4)=(-2.0_lrk*xi+3.0_lrk*xi*xi+xi*phi)/(1.0_lrk+phi)
+    ! theta_x=+dz/dy and theta_z=-dx/dy in the Euler-Bernoulli limit.
+    nx=[0.0_lrk,r(1),r(2),0.0_lrk,0.0_lrk,r(3),r(4),0.0_lrk]
+    nz=[-r(1),0.0_lrk,0.0_lrk,r(2),-r(3),0.0_lrk,0.0_lrk,r(4)]
+    scale=gf*rho*iner*l*weights(k)
+    do j=1,8
+      do i=1,8
+        ka(i,j)=ka(i,j)+scale*nz(i)*nx(j)
+      enddo
+    enddo
+  enddo
+  if (.not.all(ieee_is_finite(ka)) .or. .not.ieee_is_finite(phi) .or. &
+      .not.ieee_is_finite(kappa)) then
+    ka=0.0_lrk; phi=0.0_lrk; kappa=0.0_lrk; ok=-1
+    return
+  endif
+  ok=1
+end subroutine timo_cowper_angular_acceleration
+
